{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolFSMStateSpecification",
  "version": "1.0.0",
  "initialState": "idle",
  "states": {
    "idle": {
      "allowedTransitions": ["active", "suspended"]
    },
    "active": {
      "allowedTransitions": ["processing", "idle", "error"]
    },
    "processing": {
      "allowedTransitions": ["completed", "active", "error"]
    },
    "completed": {
      "allowedTransitions": ["idle"]
    },
    "suspended": {
      "allowedTransitions": ["idle", "active"]
    },
    "error": {
      "allowedTransitions": ["idle", "active"]
    }
  }
}